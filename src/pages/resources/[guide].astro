---
import Base from '../../layouts/Base.astro';
import ResourceItem from '../../components/ResourceItem.astro';
import { getCollection, getEntries } from 'astro:content';
import {
  formatFullDate,
  ACCESS_LABELS,
  KIND_LABELS,
  KIND_GROUPS,
  kindGroup,
  sortKeys,
  recordTopics,
} from '../../lib/resources';
import { TOPIC_GROUPS, TOPIC_LABELS } from '../../data/topics';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => !g.data.draft);
  return guides.map((guide) => ({ params: { guide: guide.id }, props: { guide } }));
}
const { guide } = Astro.props;
const g = guide.data;

const entries = (await getEntries(g.items.map((i) => i.ref))).map((entry, i) => ({ entry, note: g.items[i].note }));
// Server-side default order: newest first, undated last. The client re-sorts on demand.
entries.sort((a, b) => sortKeys(b.entry.data).date.localeCompare(sortKeys(a.entry.data).date));
const total = entries.length;
const count = (pred: (e: (typeof entries)[number]) => boolean) => entries.filter(pred).length;

// Search documents: one per record plus one per chapter, so a hit inside a table
// of contents can point at the chapter. Embedded in the page; the client indexes it.
const searchDocs = entries.flatMap(({ entry, note }) => {
  const r = entry.data;
  const record = {
    id: entry.id,
    type: 'record',
    record: entry.id,
    title: r.title,
    authors: r.authors.map((a) => a.name).join(' '),
    publisher: r.publisher ?? '',
    text: [r.description, note ?? '', KIND_LABELS[r.kind], ...recordTopics(r).map((t) => TOPIC_LABELS[t])].join(' '),
  };
  const chapters = r.contents.map((c, i) => ({
    id: `${entry.id}#${i}`,
    type: 'chapter',
    record: entry.id,
    n: i + 1,
    title: c.title,
    authors: '',
    publisher: '',
    text: [c.note ?? '', ...c.topics.map((t) => TOPIC_LABELS[t])].join(' '),
    topics: c.topics,
  }));
  return [record, ...chapters];
});

// The two book filters that earn their place: how you get it, and what it is.
const accessValues = (Object.keys(ACCESS_LABELS) as (keyof typeof ACCESS_LABELS)[])
  .map((k) => ({ id: k, label: ACCESS_LABELS[k], n: count((e) => e.entry.data.access === k) }))
  .filter((v) => v.n > 0);
const kindValues = KIND_GROUPS.map((k) => ({ id: k.id, label: k.label, n: count((e) => kindGroup(e.entry.data.kind) === k.id) })).filter(
  (v) => v.n > 0,
);

// Topics as a table of contents: every group, every topic with a record count.
const topicGroups = TOPIC_GROUPS.map((grp) => ({
  label: grp.label,
  values: grp.topics
    .map((t) => ({ id: t.id, label: t.label, n: count((e) => recordTopics(e.entry.data).includes(t.id)) }))
    .filter((v) => v.n > 0),
})).filter((grp) => grp.values.length > 0);
---
<Base title={g.title} section="resources" description={g.description}>
  <header class="article-head">
    <p class="meta"><a href="/resources/">Resources</a> · Last checked {formatFullDate(g.updated)}</p>
    <h1>{g.title}</h1>
    {g.intro && <p class="intro">{g.intro}</p>}
  </header>

  <div class="guide" id="guide" data-total={total}>
    <nav class="toc" aria-label="Topics">
      <details class="toc-wrap" open>
        <summary><span class="toc-title">Topics</span><span class="toc-hint">Tagged on chapters. Pick one to see the books with a chapter on it; use + to add topics and find books that cover them all.</span></summary>
        <button type="button" class="toc-clear" id="toc-clear" hidden>× Clear all topics</button>
        {
          topicGroups.map((grp) => (
            <div class="toc-group">
              <p class="toc-heading">{grp.label}</p>
              {grp.values.map((v) => (
                <div class="toc-row">
                  <button type="button" class="toc-add" data-topic={v.id} aria-label={`Add ${v.label}`} hidden>+</button>
                  <label class="toc-item">
                    <input type="checkbox" name="topic" value={v.id} form="filters" />
                    <span>{v.label}</span>
                    <data value={v.n}>{v.n}</data>
                  </label>
                </div>
              ))}
            </div>
          ))
        }
      </details>
    </nav>

    <div class="results">
      <form class="toolbar" id="filters" aria-label="Search and filter" onsubmit="return false">
        <div class="search-row">
          <label class="visually-hidden" for="q">Search</label>
          <input id="q" type="search" name="q" placeholder="Search titles, authors, chapters, topics" autocomplete="off" disabled />
          <button type="button" class="scope-all" id="scope-all" hidden>Search everything instead</button>
        </div>
        <p class="topic-suggest" id="topic-suggest" hidden></p>
        <fieldset class="chips" data-facet="access">
          <legend>Access</legend>
          {accessValues.map((v) => (
            <label><input type="checkbox" name="access" value={v.id} /><span>{v.label}</span><data value={v.n}>{v.n}</data></label>
          ))}
        </fieldset>
        <fieldset class="chips" data-facet="kind">
          <legend>Kind</legend>
          {kindValues.map((v) => (
            <label><input type="checkbox" name="kind" value={v.id} /><span>{v.label}</span><data value={v.n}>{v.n}</data></label>
          ))}
        </fieldset>
      </form>

      <div class="results-head">
        <p class="result-line" id="result-line" aria-live="polite"><strong>{total} resources</strong></p>
        <div class="display">
          <fieldset class="seg">
            <legend>Sort</legend>
            <label><input type="radio" name="sort" value="date" checked /><span>Newest</span></label>
            <label><input type="radio" name="sort" value="title" /><span>Title</span></label>
            <label><input type="radio" name="sort" value="author" /><span>Author</span></label>
          </fieldset>
          <fieldset class="seg">
            <legend>View</legend>
            <label><input type="radio" name="view" value="full" checked /><span>Full</span></label>
            <label><input type="radio" name="view" value="compact" /><span>Compact</span></label>
          </fieldset>
        </div>
      </div>
      <ul class="resource-list" id="resource-list">
        {entries.map(({ entry, note }) => <ResourceItem resource={entry} note={note} />)}
      </ul>
      <p class="empty" id="empty" hidden>Nothing matches.</p>
    </div>
  </div>
  <script type="application/json" id="search-data" set:html={JSON.stringify(searchDocs)} />
</Base>

<script>
  import MiniSearch from 'minisearch';
  import { SYNONYMS } from '../../data/search-synonyms';
  import { TOPIC_LABELS, TOPICS } from '../../data/topics';

  // Client-side search, filter, sort, and view for the guide. Every record is
  // already in the HTML; this only hides, reorders, annotates, and counts.
  // State lives in the URL so a filtered view can be shared.
  const guide = document.getElementById('guide')!;
  const q = document.getElementById('q') as HTMLInputElement;
  const scopeAll = document.getElementById('scope-all') as HTMLButtonElement;
  const suggest = document.getElementById('topic-suggest')!;
  const list = document.getElementById('resource-list')!;
  const rows = Array.from(list.querySelectorAll<HTMLLIElement>('li.resource'));
  const resultLine = document.getElementById('result-line')!;
  const empty = document.getElementById('empty')!;
  const tocClear = document.getElementById('toc-clear') as HTMLButtonElement;
  const addButtons = Array.from(guide.querySelectorAll<HTMLButtonElement>('.toc-add'));
  const total = rows.length;
  const FACETS = ['access', 'kind', 'topic'] as const;
  type Facet = (typeof FACETS)[number];
  const PLACEHOLDER_ALL = 'Search titles, authors, chapters, topics';

  const inputs = (sel: string) => Array.from(guide.querySelectorAll<HTMLInputElement>(`input${sel}`));
  const labelOf = (facet: string, value: string) =>
    guide.querySelector<HTMLElement>(`input[name="${facet}"][value="${value}"] + span`)?.textContent ?? value;

  function selected(facet: string): string[] {
    return inputs(`[name="${facet}"]:checked`).map((i) => i.value);
  }

  /** Selected values in words. Topics must all be covered; other facets accept any. */
  function describe(facet: string, values: string[]): string {
    return values.map((v) => labelOf(facet, v)).join(facet === 'topic' ? ' and ' : ' or ');
  }

  // ---- search ----
  type Doc = { id: string; type: 'record' | 'chapter'; record: string; n?: number; title: string; authors: string; publisher: string; text: string; topics?: string[] };
  const docs: Doc[] = JSON.parse(document.getElementById('search-data')!.textContent || '[]');
  // Chapters by record, for the "on this topic" lines when a topic is chosen.
  const chaptersOf = new Map<string, { n: number; title: string; topics: string[] }[]>();
  for (const d of docs) {
    if (d.type !== 'chapter') continue;
    const l = chaptersOf.get(d.record) ?? [];
    l.push({ n: d.n!, title: d.title, topics: d.topics ?? [] });
    chaptersOf.set(d.record, l);
  }
  const index = new MiniSearch<Doc>({
    fields: ['title', 'authors', 'publisher', 'text'],
    storeFields: ['type', 'record', 'n', 'title'],
    searchOptions: { prefix: true, fuzzy: 0.2, boost: { title: 3, authors: 2 } },
  });
  index.addAll(docs);

  type Hit = { terms: string[]; chapters: { n: number; title: string }[] };

  /** Synonym-group terms to search alongside the query, for the result line and the search itself. */
  function expansions(text: string): string[] {
    const s = ` ${text.toLowerCase().replace(/\s+/g, ' ')} `;
    const extra = new Set<string>();
    for (const group of SYNONYMS) {
      if (group.some((term) => s.includes(` ${term} `))) {
        for (const term of group) if (!s.includes(` ${term} `)) extra.add(term);
      }
    }
    return [...extra];
  }
  let also: string[] = [];

  /** Records matching the query, with the chapters that matched inside each. Null when there is no query. */
  function runSearch(query: string): Map<string, Hit> | null {
    const text = query.trim();
    if (text.length < 2) return null;
    also = expansions(text);
    const hits = new Map<string, Hit>();
    // Expansions are exact: no fuzziness, and a multi-word synonym must match all its words.
    const strict = also.map((term) => ({ queries: term.split(' '), combineWith: 'AND', fuzzy: false, prefix: false }));
    const results = strict.length ? index.search({ combineWith: 'OR', queries: [text, ...strict] }) : index.search(text);
    for (const res of results) {
      const hit = hits.get(res.record) ?? { terms: [], chapters: [] };
      for (const t of res.terms) if (!hit.terms.includes(t)) hit.terms.push(t);
      if (res.type === 'chapter') hit.chapters.push({ n: res.n, title: res.title });
      hits.set(res.record, hit);
    }
    for (const hit of hits.values()) hit.chapters.sort((a, b) => a.n - b.n);
    return hits;
  }

  /** One regex for all matched terms, or null when there are none. */
  function termRegex(terms: string[]): RegExp | null {
    if (terms.length === 0) return null;
    return new RegExp(`(${terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi');
  }

  /** Text with the matched terms wrapped in <mark>, built from nodes rather than markup. */
  function highlighted(text: string, terms: string[]): DocumentFragment {
    const frag = document.createDocumentFragment();
    const re = termRegex(terms);
    if (!re) {
      frag.append(text);
      return frag;
    }
    // split() with a capturing group alternates plain text and matches.
    text.split(re).forEach((part, i) => {
      if (!part) return;
      if (i % 2 === 1) {
        const m = document.createElement('mark');
        m.textContent = part;
        frag.append(m);
      } else {
        frag.append(part);
      }
    });
    return frag;
  }

  /** A short window of text around the first match, with ellipses. */
  function snippet(text: string, terms: string[]): DocumentFragment | null {
    const re = termRegex(terms);
    const m = re && re.exec(text);
    if (!m) return null;
    const span = 70;
    let start = Math.max(0, m.index - span);
    let end = Math.min(text.length, m.index + m[0].length + span);
    if (start > 0) start = text.indexOf(' ', start) + 1 || start;
    if (end < text.length) end = text.lastIndexOf(' ', end);
    const frag = document.createDocumentFragment();
    if (start > 0) frag.append('…');
    frag.append(highlighted(text.slice(start, end), terms));
    if (end < text.length) frag.append('…');
    return frag;
  }

  // Original text of each field, so marks can be removed when the query changes.
  const originals = new WeakMap<HTMLElement, string>();
  function original(el: HTMLElement): string {
    let t = originals.get(el);
    if (t === undefined) {
      t = el.textContent ?? '';
      originals.set(el, t);
    }
    return t;
  }

  /** Re-render a field with marks. Returns whether anything was marked. */
  function markField(el: HTMLElement | null, terms: string[]): boolean {
    if (!el) return false;
    const text = original(el);
    if (terms.length === 0) {
      el.textContent = text;
      return false;
    }
    const frag = highlighted(text, terms);
    const marked = frag.querySelector('mark') !== null;
    el.replaceChildren(frag);
    return marked;
  }

  function line(className: string, ...content: (string | Node)[]): HTMLSpanElement {
    const el = document.createElement('span');
    el.className = className;
    el.append(...content);
    return el;
  }

  /** Show why a row is here: marks in place, chapter lines, or a snippet when the match is out of sight. */
  function annotate(row: HTMLLIElement, hit: Hit | undefined, view: string, topics: string[]) {
    const terms = hit?.terms ?? [];
    const title = row.querySelector<HTMLElement>('.title');
    const authors = row.querySelector<HTMLElement>('.authors');
    const desc = row.querySelector<HTMLElement>('.desc');
    const note = row.querySelector<HTMLElement>('.note');
    const inTitle = markField(title, terms);
    const inAuthors = markField(authors, terms);
    const inDesc = markField(desc, terms);
    const inNote = markField(note, terms);

    const box = row.querySelector<HTMLElement>('.chapter-hits')!;
    box.replaceChildren();
    if (hit) {
      if (hit.chapters.length > 0) {
        box.append(line('lab', 'In contents'));
        for (const c of hit.chapters.slice(0, 3)) {
          const titleFrag = highlighted(c.title, terms);
          const inChapterTitle = titleFrag.querySelector('mark') !== null;
          const l = line('hit', `Ch. ${c.n} — `, titleFrag);
          if (!inChapterTitle) {
            // The match came from the note or a topic label; say which topic.
            const chapter = (chaptersOf.get(row.id) ?? []).find((x) => x.n === c.n);
            const re = termRegex(terms);
            const label = chapter?.topics.map((t) => TOPIC_LABELS[t]).find((x) => re && re.test(x));
            if (label) l.append(line('via', ' · topic: ', highlighted(label, terms)));
          }
          box.append(l);
        }
        if (hit.chapters.length > 3) box.append(line('hit more', `+${hit.chapters.length - 3} more chapters match`));
      }
      // Nothing marked where the reader can see it: show a snippet from the hidden field, or the topic.
      const visible = inTitle || inAuthors || (view === 'full' && (inDesc || inNote));
      if (!visible && hit.chapters.length === 0) {
        const source = [desc, note].find((el) => el && termRegex(terms)?.test(original(el)));
        const frag = source && snippet(original(source), terms);
        if (frag) {
          box.append(line('hit snippet', frag));
        } else {
          const re = termRegex(terms);
          const label = (row.dataset.topic ?? '').split(' ').map((t) => TOPIC_LABELS[t]).find((x) => x && re && re.test(x));
          if (label) box.append(line('hit snippet', 'Topic: ', highlighted(label, terms)));
        }
      }
    } else if (topics.length > 0) {
      // Topics are chosen and there is no search: show the chapters that carry them.
      const chapters = chaptersOf.get(row.id) ?? [];
      if (topics.length === 1) {
        const matching = chapters.filter((c) => c.topics.includes(topics[0]));
        if (matching.length > 0) {
          box.append(line('lab', 'On this topic'));
          for (const c of matching.slice(0, 3)) box.append(line('hit', `Ch. ${c.n} — ${c.title}`));
          if (matching.length > 3) box.append(line('hit more', `+${matching.length - 3} more chapters`));
        }
      } else {
        // Several topics: one line per topic, naming the first chapter that covers it.
        const lines = topics
          .map((t) => ({ t, matching: chapters.filter((c) => c.topics.includes(t)) }))
          .filter((x) => x.matching.length > 0);
        if (lines.length > 0) {
          box.append(line('lab', 'On these topics'));
          for (const { t, matching } of lines) {
            const first = matching[0];
            const more = matching.length > 1 ? ` (+${matching.length - 1} more)` : '';
            box.append(line('hit', line('via-topic', `${TOPIC_LABELS[t]}: `), `Ch. ${first.n} — ${first.title}${more}`));
          }
        }
      }
    }
    box.hidden = box.childElementCount === 0;
  }

  /** A record must carry every chosen topic; for the other facets, any chosen value will do. */
  function matches(row: HTMLLIElement, facet: Facet, values: string[]): boolean {
    if (values.length === 0) return true;
    const have = (row.dataset[facet] ?? '').split(' ').filter(Boolean);
    return facet === 'topic' ? values.every((v) => have.includes(v)) : values.some((v) => have.includes(v));
  }

  function apply() {
    const sel = Object.fromEntries(FACETS.map((f) => [f, selected(f)])) as Record<Facet, string[]>;
    const sort = selected('sort')[0] ?? 'date';
    const view = selected('view')[0] ?? 'full';
    const hits = runSearch(q.value);
    const inSearch = (row: HTMLLIElement) => hits === null || hits.has(row.id);

    // Visibility: the search AND every facet; OR within access and kind, AND within topics.
    let shown = 0;
    for (const row of rows) {
      const ok = inSearch(row) && FACETS.every((f) => matches(row, f, sel[f]));
      row.hidden = !ok;
      if (ok) shown++;
      annotate(row, hits?.get(row.id), view, sel.topic);
    }

    // Counts: what the list would show if this value were the only selection in its facet,
    // with the search and every other facet as currently set. For a topic that is what a
    // click gives, since a click switches topics. Once two or more topics are combined, a
    // topic's count is instead how many of the current results also cover it, and topics
    // at zero grey out; a chosen topic shows the current total.
    const count = (f: Facet, values: string[]) =>
      rows.filter((row) => inSearch(row) && FACETS.every((g) => (g === f ? matches(row, g, values) : matches(row, g, sel[g])))).length;
    const combining = sel.topic.length > 1;
    for (const f of FACETS) {
      for (const input of inputs(`[name="${f}"]`)) {
        const n =
          f === 'topic' && combining ? (input.checked ? shown : count(f, [...sel.topic, input.value])) : count(f, [input.value]);
        const d = input.parentElement!.querySelector('data')!;
        d.textContent = String(n);
        d.setAttribute('value', String(n));
        input.parentElement!.classList.toggle('none', n === 0 && !input.checked);
      }
    }

    // Beside each topic, once any is chosen: × on a chosen topic removes just that one;
    // + on another adds it. Its count is what adding gives.
    for (const b of addButtons) {
      const t = b.dataset.topic!;
      const label = labelOf('topic', t);
      const isChosen = sel.topic.includes(t);
      b.classList.toggle('remove', isChosen);
      b.textContent = isChosen ? '×' : '+';
      if (isChosen) {
        b.hidden = false;
        b.classList.remove('no-overlap');
        b.title = `Remove ${label}`;
        b.setAttribute('aria-label', b.title);
        continue;
      }
      const n = sel.topic.length > 0 ? count('topic', [...sel.topic, t]) : 0;
      // When combining, a topic with no overlap is greyed out and gets no +.
      const show = sel.topic.length > 0 && !(combining && n === 0);
      b.hidden = !show;
      if (!show) continue;
      // A + that would empty the list stays visible but pale, and says why; clicking it still
      // adds the topic, and the empty-list message then explains the dead end.
      // Topic names often contain "and", so list them with a separator rather than in a sentence.
      const all = [...sel.topic, t].map((v) => labelOf('topic', v)).join(' + ');
      b.classList.toggle('no-overlap', n === 0);
      b.title = n === 0 ? `No book covers ${all}` : `Add ${label} (${n} ${n === 1 ? 'book covers' : 'books cover'} ${all})`;
      b.setAttribute('aria-label', b.title);
    }

    // Order: newest first for dates, A to Z for the rest.
    const key = `sort${sort[0].toUpperCase()}${sort.slice(1)}`;
    const dir = sort === 'date' ? -1 : 1;
    rows
      .slice()
      .sort((a, b) => dir * (a.dataset[key] ?? '').localeCompare(b.dataset[key] ?? ''))
      .forEach((row) => list.appendChild(row));

    list.classList.toggle('compact', view === 'compact');

    // A query that names a topic, or lands in a topic's scope note or synonym group, gets the topic
    // offered directly, since the topic view lists the chapters. Name matches rank first.
    suggest.replaceChildren();
    const queryWords = q.value.trim().toLowerCase().split(/\s+/).filter((w) => w.length >= 3);
    const wordStart = (words: string[]) =>
      words.length ? new RegExp(`\\b(${words.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'i') : null;
    const direct = wordStart(queryWords);
    const viaSynonym = wordStart(also.filter((w) => w.length >= 3));
    const matchedTopics =
      hits && sel.topic.length === 0 && direct
        ? inputs('[name="topic"]')
            .map((i) => {
              const scope = TOPICS.find((t) => t.id === i.value)?.scope ?? '';
              const label = labelOf('topic', i.value);
              // Rank: the query word in the name, then a synonym in the name, then either in the scope note.
              const rank = direct.test(label) ? 0 : viaSynonym?.test(label) ? 1 : direct.test(scope) ? 2 : viaSynonym?.test(scope) ? 3 : -1;
              return { input: i, label, rank };
            })
            .filter((m) => m.rank >= 0)
            .sort((a, b) => a.rank - b.rank)
            .slice(0, 3)
        : [];
    if (matchedTopics.length > 0) {
      suggest.append(matchedTopics.length === 1 ? 'There is a topic for this: ' : 'There are topics for this: ');
      matchedTopics.forEach(({ input, label }, i) => {
        if (i > 0) suggest.append(' · ');
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.addEventListener('click', () => {
          inputs('[name="topic"]').forEach((t) => (t.checked = t === input));
          q.value = '';
          apply();
        });
        suggest.append(b);
      });
    }
    suggest.hidden = matchedTopics.length === 0;

    // Search scope follows the chosen topic.
    const topicName = sel.topic.length === 1 ? labelOf('topic', sel.topic[0]) : sel.topic.length > 1 ? 'these topics' : '';
    q.placeholder = topicName ? `Search within ${topicName}` : PLACEHOLDER_ALL;
    scopeAll.hidden = !(topicName && q.value.trim().length >= 2);

    // Result line, in words.
    const active = FACETS.filter((f) => sel[f].length > 0);
    const anything = active.length > 0 || hits !== null;
    resultLine.replaceChildren();
    const strong = document.createElement('strong');
    strong.textContent = anything ? `Showing ${shown} of ${total}` : `${total} resources`;
    resultLine.append(strong);
    if (anything) {
      const term = (text: string, remove: () => void, aria: string) => {
        resultLine.append(' · ');
        const span = document.createElement('span');
        span.className = 'term';
        span.textContent = text;
        const x = document.createElement('button');
        x.type = 'button';
        x.className = 'remove';
        x.setAttribute('aria-label', aria);
        x.textContent = '×';
        x.addEventListener('click', () => {
          remove();
          apply();
        });
        span.append(' ', x);
        resultLine.append(span);
      };
      if (hits !== null) {
        term(`matching “${q.value.trim()}”` + (also.length ? ` (also ${also.slice(0, 4).join(', ')})` : ''), () => (q.value = ''), 'Clear search');
      }
      for (const f of active) {
        if (f === 'topic') {
          // Each topic is its own term, so one can be dropped without losing the rest.
          for (const v of sel.topic) {
            term(labelOf(f, v), () => inputs(`[name="topic"][value="${v}"]`).forEach((i) => (i.checked = false)), `Remove ${labelOf(f, v)} topic`);
          }
        } else {
          term(describe(f, sel[f]), () => inputs(`[name="${f}"]`).forEach((i) => (i.checked = false)), `Remove ${labelOf(f, sel[f][0])} filter`);
        }
      }
      resultLine.append(' · ');
      const clear = document.createElement('button');
      clear.type = 'button';
      clear.className = 'clear';
      clear.textContent = 'Clear all';
      clear.addEventListener('click', () => {
        inputs('[type="checkbox"]').forEach((i) => (i.checked = false));
        q.value = '';
        apply();
      });
      resultLine.append(clear);
    }
    empty.hidden = shown > 0;
    empty.textContent = sel.topic.length > 1 && shown === 0 ? 'No single book covers all of these topics. Remove one to widen the list.' : 'Nothing matches.';
    tocClear.hidden = sel.topic.length === 0;

    // URL state.
    const params = new URLSearchParams();
    if (hits !== null) params.set('q', q.value.trim());
    for (const f of active) params.set(f, sel[f].join(','));
    if (sort !== 'date') params.set('sort', sort);
    if (view !== 'full') params.set('view', view);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  // Restore state from the URL.
  const params = new URLSearchParams(location.search);
  q.value = params.get('q') ?? '';
  for (const f of FACETS) {
    for (const v of (params.get(f) ?? '').split(',').filter(Boolean)) {
      const input = guide.querySelector<HTMLInputElement>(`input[name="${f}"][value="${v}"]`);
      if (input) input.checked = true;
    }
  }
  for (const name of ['sort', 'view']) {
    const v = params.get(name);
    const input = v && guide.querySelector<HTMLInputElement>(`input[name="${name}"][value="${v}"]`);
    if (input) input.checked = true;
  }

  // Topics behave as a table of contents: clicking one switches to it, and clicking the
  // current one clears it. The + beside a topic adds it instead, narrowing the list to
  // books that cover every chosen topic.
  guide.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'topic' && t.checked) inputs('[name="topic"]').forEach((i) => (i.checked = i === t));
    apply();
  });
  for (const b of addButtons) {
    b.addEventListener('click', () => {
      const input = guide.querySelector<HTMLInputElement>(`input[name="topic"][value="${b.dataset.topic}"]`);
      if (input) input.checked = !input.checked;
      apply();
    });
  }
  tocClear.addEventListener('click', () => {
    inputs('[name="topic"]').forEach((i) => (i.checked = false));
    apply();
  });
  let timer = 0;
  q.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(apply, 150);
  });
  scopeAll.addEventListener('click', () => {
    inputs('[name="topic"]').forEach((i) => (i.checked = false));
    apply();
  });
  q.disabled = false;
  guide.classList.add('js');
  apply();
</script>
