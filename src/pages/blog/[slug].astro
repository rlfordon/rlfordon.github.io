---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = (x: Date) =>
  x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const wayback = d.originalUrl ? `https://web.archive.org/web/2026/${d.originalUrl}` : undefined;
---
<Base title={d.title} description={d.description} section="blog" ogType="article">
  <article>
    <header class="article-head">
      <p class="meta">
        <b>Writing</b> · <time datetime={d.pubDate.toISOString().slice(0, 10)}>{fmt(d.pubDate)}</time>
        {d.categories.length > 0 && <span> · {d.categories.join(' · ')}</span>}
      </p>
      <h1>{d.title}</h1>
      {
        d.originalUrl && (
          <p class="provenance">
            Originally published at <em>{d.originalSite ?? 'another site'}</em> (<a href={wayback}>archived copy</a>).
            Republished here unchanged apart from formatting.
          </p>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="article-foot">
      {d.tags.length > 0 && <div class="taglist">{d.tags.map((t) => <span>{t}</span>)}</div>}
      <p class="more"><a href="/blog/">← All writing</a></p>
    </footer>
  </article>
</Base>
